				ti = FilterOptions (target [tidx], opt);
				sk [0] = Category (ti);
				sk [1] = Level1 (ti);
				if ((opt & COpt::IgnoreNonSpace) == 0)
					sk [2] = Level2 (ti, ExtenderType::None);
