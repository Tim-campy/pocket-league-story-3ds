		int IndexOf (Str s, Str target, int start, int length, byte* targetSortKey, Context& ctx)
		{
			int opt = ctx.Option;
			int tidx = 0;
			for (; tidx < target.Length; tidx++)
				if (!IsIgnorable (target [tidx], opt))
					break;
			if (tidx == target.Length)
				return start;
			Contraction ct = GetContraction (target, tidx, target.Length - tidx);
			Str replace = ct != nullptr ? ct->Replacement : nullptr;
			byte* sk = replace == nullptr ? targetSortKey : nullptr;
			bool noLv4 = true;
			char16_t tc = char16_t{};
			int ti = -1;
			if (ct != nullptr && sk != nullptr) {
				for (int i = 0; i < ct->SortKey.Length; i++)
					sk [i] = ct->SortKey [i];
			} else if (sk != nullptr) {
				tc = target [tidx];
				ti = FilterOptions (target [tidx], opt);
				sk [0] = Category (ti);
				sk [1] = Level1 (ti);
				if ((opt & COpt::IgnoreNonSpace) == 0)
					sk [2] = Level2 (ti, ExtenderType::None);
				sk [3] = Uni::Level3 (ti);
				noLv4 = !Uni::HasSpecialWeight ((char16_t) ti);
			}
			if (sk != nullptr) {
				for (tidx++; tidx < target.Length; tidx++) {
					if (Category (target [tidx]) != 1)
						break;
					if (sk [2] == 0)
						sk [2] = 2;
					sk [2] = (byte) (sk [2] + Level2 (target [tidx], ExtenderType::None));
				}
			}

			do {
				int idx = 0;
				if (replace != nullptr)
					idx = IndexOf (s, replace, start, length, targetSortKey, ctx);
				else
					idx = IndexOfSortKey (s, start, length, sk, tc, ti, noLv4, ctx);
				if (idx < 0)
					return -1;
				length -= idx - start;
				start = idx;
				if (IsPrefix (s, target, start, length, false, ctx))
					return idx;
				Contraction cts = GetContraction (s, start, length);
				if (cts != nullptr) {
					start += cts->Source.Length;
					length -= cts->Source.Length;
				} else {
					start++;
					length--;
				}
			} while (length > 0);
			return -1;
		}

