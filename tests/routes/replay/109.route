# Diagnostic route (no game data): new game from an empty profile.
# Run without --diagnostic-save-from-attempt. Title START -> save slot screen
# (TitleForm state 1, "Empty Slot" selected) -> SELECT calls TitleForm.NewGame
# (SubForm 71, Back on the right: it must be confirmed, not dismissed) -> team
# naming (SubForm 69: 0 name, 1 short name, 2 ..., 3 start -> AppData.NewGame,
# UserData.NewGame and the data NewGame methods) -> opening events.
anchor timeout=2400
wait frames=104
key SELECT
wait frames=60
key SELECT
wait frames=60
key SELECT
wait frames=60
key SELECT
wait frames=60
key SELECT
wait frames=60
key DOWN
wait frames=10
key DOWN
wait frames=10
key DOWN
wait frames=10
key SELECT
wait frames=120
dismiss until form=GameForm label_right=* timeout=6000 optional
dismiss until form=GameForm label_right=* timeout=200 optional
key SELECT
wait frames=100
dismiss until form=GameForm label_right=* timeout=200 optional
key SELECT
wait frames=100
end
