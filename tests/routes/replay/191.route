# Diagnostic route (no game data), run with --diagnostic-save-from-attempt 107.
# Options (SubForm 14): BGM/SE track bars dragged along y 99 / 122
# (GameView.OnTouchTrackBar); Sponsors (SubForm 42): hold the last visible row
# and drag below the list, then the first row upwards (OnTouchVScrollButton).
anchor timeout=2400
wait frames=110
key SELECT
wait frames=70
key UP
wait frames=20
key SELECT
wait frames=60
wait not loading stable=20 timeout=900
dismiss until form=GameForm label_right=* timeout=600 optional
wait frames=60
