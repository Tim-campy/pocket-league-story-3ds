# Diagnostic route (no game data): season loop from the post-match save.
# Each turn: clear dialogs back to management, advance with SELECT, and wait out
# any match (SoccerForm) until management returns. Run with --fast.
anchor timeout=2400
wait frames=104
key SELECT
wait frames=36
key UP
wait frames=24
key SELECT
wait form=GameForm label_right=* timeout=600
dismiss until form=GameForm label_right=* timeout=900 optional
key SELECT
wait frames=120
wait form=GameForm timeout=8000 optional
dismiss until form=GameForm label_right=* timeout=900 optional
