# Diagnostic route (no game data): season loop from the post-match save.
# Each turn: clear dialogs back to management. If a dialog is still on top
# (e.g. the year-end 'dismiss a player?' question, SubForm type_ 72, which
# loops when the team is at the 11-player minimum), answer No with RIGHT +
# SELECT; a labeled list is left with SOFT2. Advance with SELECT. Run with --fast.
anchor timeout=2400
wait frames=104
key SELECT
wait frames=36
key UP
wait frames=24
key SELECT
wait form=GameForm label_right=* timeout=600
dismiss until form=GameForm label_right=* timeout=200 optional
when form=SubForm label_right=* key SOFT2
wait frames=10
when form=SubForm key RIGHT
wait frames=10
when form=SubForm key SELECT
wait frames=20
key SELECT
wait frames=100
dismiss until form=GameForm label_right=* timeout=200 optional
when form=SubForm label_right=* key SOFT2
wait frames=10
